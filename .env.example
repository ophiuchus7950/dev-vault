# ---- Postgres (docker compose) ----
POSTGRES_USER=devvault
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=devvault

# ---- API ----
# For `docker compose` the host is `db`; for local `cargo run` use `localhost`.
DATABASE_URL=postgres://devvault:change-me-in-production@localhost:5432/devvault
BIND_ADDR=127.0.0.1:3000
RUST_LOG=info,devvault=debug
LOG_FORMAT=pretty
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- Tunables ----
MAX_PAGE_SIZE=100
DEFAULT_PAGE_SIZE=20
SEARCH_MIN_TRGM_SCORE=0.3
IMPORT_MAX_BYTES=16777216
